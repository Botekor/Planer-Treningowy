<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView4"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="#1373D9"
        android:paddingVertical="4sp"
        android:text="@string/Tytul"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="380dp"
        android:layout_height="214dp"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:contentDescription="@string/Sportowiec"
        android:scaleType="fitStart"
        app:srcCompat="@drawable/sportowiec" />

    <Button
        android:id="@+id/button2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        android:layout_marginVertical="6dp"
        android:backgroundTint="#1373D9"
        android:text="@string/losuj_wiczenie"
        android:textColorLink="#673AB7"
        app:cornerRadius="13dp" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="152dp"
        android:layout_gravity="center"
        android:layout_marginHorizontal="12sp"
        android:layout_marginVertical="6sp"
        android:adjustViewBounds="true"
        android:background="#D2DAED"
        android:contentDescription="@string/cwiczenia"
        app:srcCompat="@drawable/cwiczenie1" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/nazwaCwiczenia"
        android:textColor="#000000"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TableRow
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:gravity="center">

        <Button
            android:id="@+id/button4"
            android:layout_width="75dp"
            android:layout_height="57dp"
            android:height="30dp"
            android:backgroundTint="#BFCDE1"
            android:text="@string/minus"
            android:textColor="#020202"
            android:textSize="28sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <Space
            android:layout_width="55dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="47dp"
            android:gravity="center"
            android:text="@string/_3"
            android:textColorHint="#000000"
            android:textSize="41sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="55dp"
            android:layout_height="0dp" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/button5"
            android:layout_width="65dp"
            android:layout_height="57dp"
            android:backgroundTint="#BFCDE1"
            android:text="@string/plus"
            android:textColor="#000000"
            android:textSize="28sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </TableRow>

    <TableRow
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:gravity="center">

        <Button
            android:id="@+id/button6"
            android:layout_width="165dp"
            android:layout_height="64dp"
            android:backgroundTint="#12AD35"
            android:text="@string/nastpne_wiczenie"
            app:cornerRadius="12dp" />

        <Space
            android:layout_width="15dp"
            android:layout_height="1dp" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/button7"
            android:layout_width="165dp"
            android:layout_height="64dp"
            android:backgroundTint="#EB0808"
            android:text="@string/reset"
            app:cornerRadius="12dp" />
    </TableRow>

    <TextView
        android:id="@+id/textView5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:background="#D2DAED"
        android:gravity="center"
        android:text="@string/liczba_serii"
        android:textSize="26sp"
        android:textStyle="bold" />
</LinearLayout>